NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_CAMPAIGNS_CONTRACT_ID=CBLE7UFHEZT7YCWABJN5JCH5V7O4BVUWRNCPYZ5HVTUKDGV3OIAVKSXV
NEXT_PUBLIC_TOKEN_CONTRACT_ID=CBR455EYJZ54MTAOGRKB6M2GCNFLENMVUOPEKXXDWVPODEZLRW7V2PRD
NEXT_PUBLIC_TOKEN_SYMBOL=vUSD
# Issuer (G...) of the classic asset behind the token. Lets device wallets opt in (sponsored trustline) and powers the faucet.
NEXT_PUBLIC_TOKEN_ISSUER=GDCSTIPNL2YTPNEYZWFVMSEYOW5SEFC6FFWU2CSIVS67CHCV34YS6B26
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org
# Passkey smart-wallet WASM hash. Leave empty to fall back to device wallets.
NEXT_PUBLIC_WALLET_WASM_HASH=
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet
# ---- Everything below is SERVER ONLY (never NEXT_PUBLIC_, never committed with a value) ----
# funded testnet account that pays fees when no relayer is configured
SPONSOR_SECRET=

# Optional shared rate limiter for serverless (Upstash Redis REST or Vercel KV). Without it the
# limiter is per instance, which is only a soft limit on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV integration names are also read: KV_REST_API_URL / KV_REST_API_TOKEN)

# Optional OpenZeppelin relayer. Needs both. If it errors or exceeds RELAYER_TIMEOUT_MS the claim
# falls back to SPONSOR_SECRET (when set). Passkey wallet creation requires the relayer.
RELAYER_URL=
RELAYER_API_KEY=
RELAYER_TIMEOUT_MS=12000
# Max time /api/claim waits for confirmation before returning a pending hash (client then polls).
CONFIRM_BUDGET_MS=20000
