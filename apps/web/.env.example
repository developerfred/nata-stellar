# Copy to .env.local (local) or add in Vercel > Project > Settings > Environment Variables.
# Never commit real values for the server-only section.

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_*  -> inlined into the browser bundle at build time. Public by design:
#                   contract IDs and URLs only, never a secret. Changing one needs a rebuild.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_CAMPAIGNS_CONTRACT_ID=CBLE7UFHEZT7YCWABJN5JCH5V7O4BVUWRNCPYZ5HVTUKDGV3OIAVKSXV
NEXT_PUBLIC_TOKEN_CONTRACT_ID=CBR455EYJZ54MTAOGRKB6M2GCNFLENMVUOPEKXXDWVPODEZLRW7V2PRD
NEXT_PUBLIC_TOKEN_SYMBOL=vUSD
# Issuer (G...) of the classic asset behind the token. Lets device wallets opt in to the token (sponsored trustline).
NEXT_PUBLIC_TOKEN_ISSUER=GDCSTIPNL2YTPNEYZWFVMSEYOW5SEFC6FFWU2CSIVS67CHCV34YS6B26
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org
# Passkey smart-wallet WASM hash. Leave empty to fall back to device wallets.
NEXT_PUBLIC_WALLET_WASM_HASH=

# ---------------------------------------------------------------------------
# SERVER ONLY  -> read in API routes, never sent to the browser. Secrets live here.
# ---------------------------------------------------------------------------
# Funded testnet account (S...) that pays fees (and signs fee bumps for trustlines). Required unless a relayer is set.
SPONSOR_SECRET=
# Optional OpenZeppelin relayer for claims and passkey wallets (https://channels.openzeppelin.com/testnet/gen).
RELAYER_URL=
RELAYER_API_KEY=
# Optional rate limiting shared across serverless instances (Vercel KV / Upstash Redis REST).
# Without it, limits are per instance and reset on cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
